<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicalsecurity.ui.controllers.VerifyDecryptController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Verify &amp; Decrypt" styleClass="label-title"/>
    <Label text="Integrity is verified before decryption. If the ciphertext or the manifest was modified, decryption is refused and nothing is written to disk."
           styleClass="label-muted" wrapText="true"/>

    <VBox styleClass="card" spacing="10">
        <Label text="Transfer ID"/>
        <HBox spacing="8">
            <TextField fx:id="transferIdField" promptText="paste or type a transfer id" HBox.hgrow="ALWAYS"/>
            <Button text="Load incoming" onAction="#handleLoad"/>
        </HBox>
        <HBox spacing="8">
            <Button fx:id="verifyButton" text="Verify integrity" onAction="#handleVerify"/>
            <Button fx:id="decryptButton" text="Verify &amp; Decrypt to file..." onAction="#handleDecrypt"/>
        </VBox>
        <Label fx:id="statusLabel" text="" styleClass="label-muted" wrapText="true"/>
        <TextArea fx:id="detailArea" editable="false" prefRowCount="10" wrapText="true"/>
    </VBox>
</VBox>
