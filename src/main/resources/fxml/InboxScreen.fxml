<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<VBox spacing="14" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicalsecurity.ui.controllers.InboxController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Inbox - Incoming Transfers" styleClass="label-title"/>
    <Label text="Select a transfer and open Verify &amp; Decrypt to process it. Only the addressed recipient can decrypt."
           styleClass="label-muted" wrapText="true"/>
    <HBox spacing="8">
        <Button text="Refresh" onAction="#handleRefresh"/>
        <Button fx:id="rejectButton" text="Reject selected" styleClass="button-danger" onAction="#handleReject"/>
        <Label fx:id="infoLabel" text="" styleClass="label-muted"/>
    </HBox>
    <TableView fx:id="table">
        <columns>
            <TableColumn fx:id="colId" text="Transfer ID" prefWidth="260"/>
            <TableColumn fx:id="colFile" text="File" prefWidth="180"/>
            <TableColumn fx:id="colSize" text="Bytes" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
            <TableColumn fx:id="colReceived" text="Received" prefWidth="180"/>
        </columns>
    </TableView>
</VBox>
