<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicalsecurity.ui.controllers.UserManagementController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="User Management" styleClass="label-title"/>

    <VBox styleClass="card" spacing="8">
        <Label text="Create account" styleClass="label-subtitle"/>
        <HBox spacing="8">
            <TextField fx:id="newUsernameField" promptText="username"/>
            <PasswordField fx:id="newPasswordField" promptText="password"/>
            <TextField fx:id="newFullNameField" promptText="full name" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="newRoleBox" promptText="role"/>
            <Button text="Create" onAction="#handleCreate"/>
        </HBox>
        <HBox spacing="8">
            <Button fx:id="toggleButton" text="Enable/Disable selected" onAction="#handleToggle"/>
            <Label fx:id="infoLabel" text="" styleClass="label-muted"/>
        </HBox>
    </VBox>

    <TableView fx:id="table">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="160"/>
            <TableColumn fx:id="colFullName" text="Full name" prefWidth="200"/>
            <TableColumn fx:id="colRole" text="Role" prefWidth="120"/>
            <TableColumn fx:id="colActive" text="Active" prefWidth="90"/>
            <TableColumn fx:id="colCreated" text="Created" prefWidth="180"/>
        </columns>
    </TableView>
</VBox>
