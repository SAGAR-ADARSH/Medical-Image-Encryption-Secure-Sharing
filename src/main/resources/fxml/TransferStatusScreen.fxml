<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<VBox spacing="14" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicalsecurity.ui.controllers.TransferStatusController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Transfer History &amp; Status" styleClass="label-title"/>
    <Label text="State machine: PENDING → ENCRYPTING → SENDING → RECEIVED → VERIFIED → DECRYPTED (FAILED / REJECTED are terminal)."
           styleClass="label-muted" wrapText="true"/>
    <HBox spacing="8">
        <Button text="Refresh" onAction="#handleRefresh"/>
        <Label fx:id="infoLabel" text="" styleClass="label-muted"/>
    </HBox>
    <TableView fx:id="table">
        <columns>
            <TableColumn fx:id="colId" text="Transfer ID" prefWidth="250"/>
            <TableColumn fx:id="colSender" text="Sender #" prefWidth="90"/>
            <TableColumn fx:id="colRecipient" text="Recipient #" prefWidth="100"/>
            <TableColumn fx:id="colFile" text="File" prefWidth="170"/>
            <TableColumn fx:id="colPlain" text="Plain" prefWidth="80"/>
            <TableColumn fx:id="colCipher" text="Cipher" prefWidth="80"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
            <TableColumn fx:id="colUpdated" text="Updated" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>
