<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<VBox spacing="14" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicalsecurity.ui.controllers.AuditLogController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Audit Log" styleClass="label-title"/>
    <Label text="Authentication, key release, encryption, decryption and denied-access events (append-only)."
           styleClass="label-muted" wrapText="true"/>
    <HBox spacing="8">
        <Button text="Refresh" onAction="#handleRefresh"/>
        <Label fx:id="infoLabel" text="" styleClass="label-muted"/>
    </HBox>
    <TableView fx:id="table">
        <columns>
            <TableColumn fx:id="colTime" text="Time" prefWidth="170"/>
            <TableColumn fx:id="colType" text="Event" prefWidth="160"/>
            <TableColumn fx:id="colUser" text="User" prefWidth="130"/>
            <TableColumn fx:id="colOutcome" text="Outcome" prefWidth="100"/>
            <TableColumn fx:id="colDetail" text="Detail" prefWidth="320"/>
            <TableColumn fx:id="colIp" text="Source" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
