<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>

<VBox spacing="14" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicalsecurity.ui.controllers.KeyManagementController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Key Management" styleClass="label-title"/>
    <Label text="Public keys are stored in the database (DER). Private keys stay inside each user's PKCS#12 keystore and are never exported."
           styleClass="label-muted" wrapText="true"/>
    <HBox spacing="8">
        <Button text="Refresh" onAction="#handleRefresh"/>
        <Button fx:id="provisionButton" text="Provision missing key pairs" onAction="#handleProvision"/>
        <Label fx:id="infoLabel" text="" styleClass="label-muted"/>
    </HBox>
    <TableView fx:id="table">
        <columns>
            <TableColumn fx:id="colUser" text="Username" prefWidth="160"/>
            <TableColumn fx:id="colAlg" text="Algorithm" prefWidth="110"/>
            <TableColumn fx:id="colBits" text="Bits" prefWidth="80"/>
            <TableColumn fx:id="colVersion" text="Version" prefWidth="80"/>
            <TableColumn fx:id="colFingerprint" text="SHA-256 fingerprint (public key)" prefWidth="360"/>
        </columns>
    </TableView>
    <Label text="Selected key details"/>
    <TextArea fx:id="detailArea" editable="false" prefRowCount="5" wrapText="true"/>
</VBox>
